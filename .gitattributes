# Force LF line endings in the repository regardless of contributor OS.
# Windows users see CRLF locally if their config wants it, but the repo
# itself stays consistent. This prevents the classic "whole file shows as
# modified" diff noise when a Windows user edits one line.

* text=auto eol=lf

# Explicit text files
*.php       text eol=lf
*.sql       text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.sh        text eol=lf

# Binary — never try to "fix" line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.sqlite    binary
