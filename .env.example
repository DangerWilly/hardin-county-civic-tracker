# Copy to .env (which is git-ignored) and fill in real values.
# .env is loaded by src/bootstrap.php on every request.

# Set to 1 in dev, 0 in prod. Controls error display.
APP_DEBUG=1

# Timezone for ALL date interpretation across the codebase. Default is
# Eastern (Ohio). Use a valid PHP timezone identifier — see
# https://www.php.net/manual/en/timezones.america.php
# Database timestamps stay as unix epoch ints; this just controls
# parse/format behavior at the edges.
APP_TIMEZONE=America/New_York

# REQUIRED in prod. Generate with: openssl rand -hex 32
# Used to hash visitor IPs before storing them. Changing it invalidates
# every existing rate-limit window — that's fine.
IP_HASH_SECRET=dev-salt-change-me-before-deploy

# Admin authentication.
#
# Generate both values by running:
#     php tools/set_admin_password.php
# It prints the lines to paste here.
#
# If ADMIN_PASSWORD_HASH is empty, login is impossible — useful safety default.
# ADMIN_COOKIE_SECRET is a long random string. Rotating it logs out every
# admin session at once (handy if a session is suspected compromised).
ADMIN_PASSWORD_HASH=
ADMIN_COOKIE_SECRET=

# Wired up later (the AI summarization endpoint).
XAI_API_KEY=

# Wired up later. Get from https://openstates.org/account/profile/
OPENSTATES_API_KEY=
